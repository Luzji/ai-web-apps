# Dùng khi triển khai giao diện React riêng (Vercel/Netlify) trỏ tới backend ở nơi khác (C3).
# Đặt biến này trong trang cài đặt của Vercel/Netlify (Environment Variables) rồi build lại.
# Không có dấu "/" ở cuối. Bỏ trống khi FastAPI tự phục vụ bản build (cùng origin).
VITE_API_URL=https://<ten-space>.hf.space
